# =============================================================================
# Configuration Oracle
# =============================================================================
# Copiez ce fichier en `.env` et renseignez vos valeurs :
#   cp .env.example .env            (Windows : copy .env.example .env)

# Identifiants de connexion Oracle
ORACLE_USER=system
ORACLE_PASSWORD=change_me

# Chaîne de connexion (Easy Connect `host:port/service` ou alias tnsnames).
# Exemples : localhost:1521/FREEPDB1  |  192.168.1.20:1521/FREEPDB1
ORACLE_CONNECTION_STRING=localhost:1521/FREEPDB1

# Pool de connexions (optionnel)
ORACLE_POOL_MIN=0
ORACLE_POOL_MAX=4
ORACLE_POOL_INCREMENT=1

# Mode Thick (optionnel) : chemin vers l'Oracle Instant Client
# ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient_21_13

# Garde-fous
QUERY_MAX_ROWS=100       # plafond de lignes pour execute_query
ALLOW_DML=true           # false = serveur strictement en lecture seule

# Niveau de log : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
